<!DOCTYPE html>
<html lang="es" class="h-full bg-slate-900">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Análisis Estático CAD & MediaPipe - Soportes Hibbeler</title>
  
  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- FontAwesome -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  
  <!-- MathJax -->
  <script>
    window.MathJax = {
      tex: { inlineMath: [['$', '$'], ['\\(', '\\)']] },
      svg: { fontCache: 'global' }
    };
  </script>
  <script id="MathJax-script" async src="https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-mml-chtml.js"></script>

  <!-- MediaPipe Hands & Camera Utils -->
  <script src="https://cdn.jsdelivr.net/npm/@mediapipe/camera_utils/camera_utils.js" crossorigin="anonymous"></script>
  <script src="https://cdn.jsdelivr.net/npm/@mediapipe/drawing_utils/drawing_utils.js" crossorigin="anonymous"></script>
  <script src="https://cdn.jsdelivr.net/npm/@mediapipe/hands/hands.js" crossorigin="anonymous"></script>

  <style>
    .glass-panel {
      background: rgba(30, 41, 59, 0.7);
      backdrop-filter: blur(12px);
      border: 1px solid rgba(255, 255, 255, 0.1);
    }
    canvas { touch-action: none; }
  </style>
</head>
<body class="h-full text-slate-100 flex flex-col font-sans overflow-x-hidden select-none">

  <!-- Puntero Virtual de MediaPipe -->
  <div id="virtual-pointer" class="hidden fixed w-8 h-8 rounded-full border-2 border-amber-400 bg-amber-400/30 z-50 transform -translate-x-1/2 -translate-y-1/2 flex items-center justify-center shadow-lg shadow-amber-500/50 pointer-events-none transition-all duration-75">
    <div id="pointer-dot" class="w-2 h-2 bg-amber-400 rounded-full"></div>
  </div>

  <!-- Header -->
  <header class="glass-panel sticky top-0 z-40 px-6 py-4 flex items-center justify-between border-b border-slate-700">
    <div class="flex items-center space-x-3">
      <div class="p-2 bg-blue-600 rounded-lg shadow-lg shadow-blue-500/30">
        <i class="fa-solid fa-compass-drafting text-xl text-white"></i>
      </div>
      <div>
        <h1 class="font-bold text-lg text-white leading-none">Estática CAD Lab</h1>
        <span class="text-xs text-slate-400">R.C. Hibbeler + MediaPipe Hands Control</span>
      </div>
    </div>
    
    <!-- Controls WebCam -->
    <div class="flex items-center space-x-4">
      <button id="toggle-cam" onclick="toggleCamera()" class="px-4 py-2 bg-blue-600 hover:bg-blue-500 border border-blue-400 rounded-lg text-xs font-semibold flex items-center space-x-2 transition text-white shadow-lg shadow-blue-600/30">
        <i class="fa-solid fa-camera text-white" id="cam-icon"></i>
        <span id="cam-btn-text">Activar Control Gestual</span>
      </button>
      <div id="cam-status" class="hidden flex items-center space-x-2 text-xs text-amber-400 bg-amber-950/40 px-3 py-1.5 rounded-full border border-amber-800/50">
        <span class="w-2 h-2 rounded-full bg-amber-400 animate-pulse"></span>
        <span id="gest-status-text">Inicializando cámara...</span>
      </div>
    </div>
  </header>

  <!-- WebCam Floating Video Feed -->
  <div id="webcam-container" class="hidden fixed bottom-4 right-4 z-50 glass-panel rounded-xl p-2 shadow-2xl border border-slate-700 w-48">
    <div class="relative w-full aspect-video rounded-lg overflow-hidden bg-black">
      <video id="webcam" class="w-full h-full object-cover transform -scale-x-100" playsinline></video>
      <canvas id="webcam-canvas" class="absolute inset-0 w-full h-full transform -scale-x-100"></canvas>
    </div>
    <div class="text-[10px] text-slate-400 mt-1.5 text-center flex justify-between px-1">
      <span>Índice = Mover</span>
      <span class="font-bold text-amber-400">Pellizco = Ajustar</span>
    </div>
  </div>

  <!-- Main Grid -->
  <main class="flex-1 p-6 grid grid-cols-1 lg:grid-cols-12 gap-6">
    
    <!-- Left Panel: Controls & Theoretical Supports -->
    <section class="lg:col-span-4 flex flex-col space-y-6">
      
      <!-- Support Selector -->
      <div class="glass-panel rounded-2xl p-5 border border-slate-700">
        <h2 class="text-sm font-semibold uppercase tracking-wider text-slate-400 mb-4 flex items-center gap-2">
          <i class="fa-solid fa-cubes text-blue-400"></i> Catálogo de Soportes (2D)
        </h2>
        <div class="grid grid-cols-2 gap-2 text-xs" id="support-buttons">
          <button onclick="selectSupport('roller', this)" class="sup-btn p-3 bg-blue-600/20 border border-blue-500 rounded-xl text-left transition flex flex-col gap-1">
            <span class="font-bold text-blue-300">Rodillo / Patín</span>
            <span class="text-[10px] text-slate-400">1 Reacción ($\mathbf{F}_y$)</span>
          </button>
          <button onclick="selectSupport('pin', this)" class="sup-btn p-3 bg-slate-800 border border-slate-700 rounded-xl text-left hover:bg-slate-700 transition flex flex-col gap-1">
            <span class="font-bold text-slate-200">Pasador Liso</span>
            <span class="text-[10px] text-slate-400">2 Reacciones ($\mathbf{F}_x, \mathbf{F}_y$)</span>
          </button>
          <button onclick="selectSupport('fixed', this)" class="sup-btn p-3 bg-slate-800 border border-slate-700 rounded-xl text-left hover:bg-slate-700 transition flex flex-col gap-1">
            <span class="font-bold text-slate-200">Empotramiento</span>
            <span class="text-[10px] text-slate-400">3 Reacciones ($\mathbf{F}_x, \mathbf{F}_y, \mathbf{M}$)</span>
          </button>
          <button onclick="selectSupport('cable', this)" class="sup-btn p-3 bg-slate-800 border border-slate-700 rounded-xl text-left hover:bg-slate-700 transition flex flex-col gap-1">
            <span class="font-bold text-slate-200">Cable / Eslabón</span>
            <span class="text-[10px] text-slate-400">1 Tensión a lo largo</span>
          </button>
        </div>
      </div>

      <!-- Controls & Sliders -->
      <div class="glass-panel rounded-2xl p-5 border border-slate-700 flex-1 flex flex-col justify-between">
        <div>
          <h2 class="text-sm font-semibold uppercase tracking-wider text-slate-400 mb-4 flex items-center gap-2">
            <i class="fa-solid fa-sliders text-amber-400"></i> Parámetros de Carga
          </h2>
          
          <div class="space-y-4 text-xs">
            <div>
              <div class="flex justify-between mb-1">
                <span class="text-slate-300">Magnitud Fuerza ($F$)</span>
                <span id="val-force" class="font-mono text-amber-400">500 N</span>
              </div>
              <input type="range" id="slider-force" min="100" max="1000" value="500" step="50" oninput="updateParams()" class="w-full accent-amber-400 bg-slate-700 rounded-lg cursor-pointer">
            </div>

            <div>
              <div class="flex justify-between mb-1">
                <span class="text-slate-300">Ángulo de Aplicación ($\theta$)</span>
                <span id="val-angle" class="font-mono text-amber-400">45°</span>
              </div>
              <input type="range" id="slider-angle" min="0" max="360" value="45" step="5" oninput="updateParams()" class="w-full accent-amber-400 bg-slate-700 rounded-lg cursor-pointer">
            </div>
          </div>
        </div>

        <!-- Dynamic Theory Explanation -->
        <div id="theory-box" class="mt-6 p-4 bg-slate-950/60 rounded-xl border border-slate-800 text-xs leading-relaxed text-slate-300 space-y-2">
          <p class="font-semibold text-blue-400">Restricciones del Soporte:</p>
          <p id="theory-desc">Un rodillo impide únicamente el movimiento perpendicular a la superficie de contacto. Por lo tanto, ejerce una única fuerza de reacción normal.</p>
        </div>
      </div>
    </section>

    <!-- Right Panel: Interactive Canvas Inspector -->
    <section class="lg:col-span-8 flex flex-col space-y-6">
      
      <!-- Interactive 2D DCL Canvas -->
      <div class="glass-panel rounded-2xl p-5 border border-slate-700 flex flex-col">
        <div class="flex justify-between items-center mb-3">
          <div class="flex items-center gap-2">
            <i class="fa-solid fa-eye text-emerald-400"></i>
            <h2 class="text-sm font-semibold uppercase tracking-wider text-slate-300">Diagrama de Cuerpo Libre (DCL) en Tiempo Real</h2>
          </div>
          <span class="text-[11px] text-slate-400 bg-slate-800 px-2.5 py-1 rounded-md border border-slate-700">Arrastra sliders o usa la cámara</span>
        </div>

        <div class="relative w-full h-80 bg-slate-950 rounded-xl overflow-hidden border border-slate-800 flex items-center justify-center">
          <canvas id="dcl-canvas" class="w-full h-full cursor-crosshair"></canvas>
        </div>

        <!-- Real-time Equilibrium Output -->
        <div class="grid grid-cols-3 gap-3 mt-4 text-center">
          <div class="p-2.5 bg-slate-950/80 rounded-xl border border-slate-800">
            <span class="text-[10px] text-slate-400 block">Reacción $\mathbf{R}_x$</span>
            <span id="out-rx" class="font-mono text-xs font-bold text-emerald-400">-353.6 N</span>
          </div>
          <div class="p-2.5 bg-slate-950/80 rounded-xl border border-slate-800">
            <span class="text-[10px] text-slate-400 block">Reacción $\mathbf{R}_y$</span>
            <span id="out-ry" class="font-mono text-xs font-bold text-emerald-400">+353.6 N</span>
          </div>
          <div class="p-2.5 bg-slate-950/80 rounded-xl border border-slate-800">
            <span class="text-[10px] text-slate-400 block">Momento $\mathbf{M}_R$</span>
            <span id="out-m" class="font-mono text-xs font-bold text-emerald-400">0.0 N·m</span>
          </div>
        </div>
      </div>

      <!-- Quick Quiz section -->
      <div class="glass-panel rounded-2xl p-5 border border-slate-700 text-xs">
        <h3 class="font-bold text-slate-200 mb-2 flex items-center gap-2">
          <i class="fa-solid fa-graduation-cap text-amber-400"></i> Comprobación de Concepto (Hibbeler Cap. 5)
        </h3>
        <p class="text-slate-400 mb-3">¿Cuántas incógnitas introduce un soporte de pasador liso en un problema bidimensional 2D?</p>
        <div class="flex gap-3">
          <button onclick="checkAnswer(1)" class="px-4 py-2 bg-slate-800 hover:bg-slate-700 border border-slate-700 rounded-lg text-slate-200">1 Incógnita</button>
          <button onclick="checkAnswer(2)" class="px-4 py-2 bg-slate-800 hover:bg-slate-700 border border-slate-700 rounded-lg text-slate-200">2 Incógnitas</button>
          <button onclick="checkAnswer(3)" class="px-4 py-2 bg-slate-800 hover:bg-slate-700 border border-slate-700 rounded-lg text-slate-200">3 Incógnitas</button>
        </div>
        <div id="quiz-feedback" class="mt-2 font-semibold hidden"></div>
      </div>

    </section>
  </main>

  <script>
    let currentSupport = 'roller';
    let forceMagnitude = 500;
    let forceAngle = 45;
    let isPinching = false;
    let camera = null;
    let camActive = false;

    const canvas = document.getElementById('dcl-canvas');
    const ctx = canvas.getContext('2d');
    const virtualPointer = document.getElementById('virtual-pointer');

    function resizeCanvas() {
      if(!canvas || !canvas.parentElement) return;
      canvas.width = canvas.parentElement.clientWidth;
      canvas.height = canvas.parentElement.clientHeight;
      drawDCL();
    }
    window.addEventListener('resize', resizeCanvas);

    const supportData = {
      roller: {
        title: 'Rodillo / Patín',
        desc: 'Evita la traslación perpendicular a la superficie. Ejerce 1 fuerza de reacción normal ($\mathbf{F}_y$). Permite rotación y deslizamiento horizontal.',
        rx: false, ry: true, m: false
      },
      pin: {
        title: 'Pasador Liso / Articulación',
        desc: 'Evita la traslación en cualquier dirección ($x, y$). Ejerce 2 componentes de fuerza ($\mathbf{F}_x, \mathbf{F}_y$). Permite la rotación libre.',
        rx: true, ry: true, m: false
      },
      fixed: {
        title: 'Empotramiento',
        desc: 'Evita la traslación completa y la rotación. Ejerce 3 reacciones: dos fuerzas ($\mathbf{F}_x, \mathbf{F}_y$) y un momento resistente ($\mathbf{M}$).',
        rx: true, ry: true, m: true
      },
      cable: {
        title: 'Cable / Eslabón',
        desc: 'Ejerce una única fuerza de tensión actuando en la dirección del cable, jalando siempre alejándose del cuerpo.',
        rx: true, ry: true, m: false
      }
    };

    function selectSupport(type, el) {
      currentSupport = type;
      document.querySelectorAll('.sup-btn').forEach(btn => {
        btn.classList.remove('bg-blue-600/20', 'border-blue-500');
        btn.classList.add('bg-slate-800', 'border-slate-700');
      });
      el.classList.remove('bg-slate-800', 'border-slate-700');
      el.classList.add('bg-blue-600/20', 'border-blue-500');

      document.getElementById('theory-desc').innerHTML = supportData[type].desc;
      if(window.MathJax && MathJax.typeset) MathJax.typeset();
      drawDCL();
    }

    function updateParams() {
      forceMagnitude = parseFloat(document.getElementById('slider-force').value);
      forceAngle = parseFloat(document.getElementById('slider-angle').value);
      
      document.getElementById('val-force').innerText = forceMagnitude + ' N';
      document.getElementById('val-angle').innerText = forceAngle + '°';
      
      drawDCL();
    }

    function drawDCL() {
      if(!ctx || !canvas.width) return;
      const w = canvas.width;
      const h = canvas.height;
      const cx = w / 2;
      const cy = h / 2 + 30;

      ctx.clearRect(0, 0, w, h);

      // Fondo Cuadrícula CAD
      ctx.strokeStyle = '#1e293b';
      ctx.lineWidth = 1;
      for(let x=0; x<w; x+=30) { ctx.beginPath(); ctx.moveTo(x,0); ctx.lineTo(x,h); ctx.stroke(); }
      for(let y=0; y<h; y+=30) { ctx.beginPath(); ctx.moveTo(0,y); ctx.lineTo(w,y); ctx.stroke(); }

      // Superficie
      ctx.fillStyle = '#334155';
      ctx.fillRect(cx - 100, cy + 20, 200, 10);

      // Símbolo Soporte
      ctx.lineWidth = 3;
      ctx.strokeStyle = '#94a3b8';
      ctx.fillStyle = '#1e293b';

      if(currentSupport === 'roller') {
        ctx.beginPath();
        ctx.arc(cx - 20, cy + 10, 10, 0, Math.PI * 2);
        ctx.arc(cx + 20, cy + 10, 10, 0, Math.PI * 2);
        ctx.fill(); ctx.stroke();
      } else if(currentSupport === 'pin') {
        ctx.beginPath();
        ctx.moveTo(cx, cy);
        ctx.lineTo(cx - 30, cy + 20);
        ctx.lineTo(cx + 30, cy + 20);
        ctx.closePath();
        ctx.fill(); ctx.stroke();
      } else if(currentSupport === 'fixed') {
        ctx.fillStyle = '#475569';
        ctx.fillRect(cx - 40, cy, 80, 20);
      }

      // Viga
      ctx.fillStyle = '#38bdf8';
      ctx.fillRect(cx - 80, cy - 20, 160, 20);
      ctx.strokeStyle = '#0284c7';
      ctx.strokeRect(cx - 80, cy - 20, 160, 20);

      // Vector Fuerza Aplicada
      const rad = (forceAngle * Math.PI) / 180;
      const len = (forceMagnitude / 1000) * 80 + 40;
      const fx = Math.cos(rad) * len;
      const fy = -Math.sin(rad) * len;

      drawArrow(cx, cy - 20, cx + fx, cy - 20 + fy, '#f59e0b', 'F = ' + forceMagnitude + 'N');

      // Cálculo de Reacciones
      const fXVal = forceMagnitude * Math.cos(rad);
      const fYVal = forceMagnitude * Math.sin(rad);
      const data = supportData[currentSupport];

      if(data.rx) { drawArrow(cx, cy - 10, cx + (-fXVal > 0 ? 50 : -50), cy - 10, '#10b981', 'Rx'); }
      if(data.ry) { drawArrow(cx, cy, cx, cy - 60, '#10b981', 'Ry'); }

      document.getElementById('out-rx').innerText = (data.rx ? (-fXVal).toFixed(1) : '0.0') + ' N';
      document.getElementById('out-ry').innerText = (data.ry ? (fYVal).toFixed(1) : '0.0') + ' N';
      document.getElementById('out-m').innerText = (data.m ? (fXVal * 0.5).toFixed(1) : '0.0') + ' N·m';
    }

    function drawArrow(fromx, fromy, tox, toy, color, label) {
      const headlen = 10;
      const dx = tox - fromx;
      const dy = toy - fromy;
      const angle = Math.atan2(dy, dx);

      ctx.strokeStyle = color;
      ctx.fillStyle = color;
      ctx.lineWidth = 3;

      ctx.beginPath();
      ctx.moveTo(fromx, fromy);
      ctx.lineTo(tox, toy);
      ctx.stroke();

      ctx.beginPath();
      ctx.moveTo(tox, toy);
      ctx.lineTo(tox - headlen * Math.cos(angle - Math.PI / 6), toy - headlen * Math.sin(angle - Math.PI / 6));
      ctx.lineTo(tox - headlen * Math.cos(angle + Math.PI / 6), toy - headlen * Math.sin(angle + Math.PI / 6));
      ctx.closePath();
      ctx.fill();

      if(label) {
        ctx.font = 'bold 11px sans-serif';
        ctx.fillText(label, tox + 10, toy);
      }
    }

    async function toggleCamera() {
      const btnText = document.getElementById('cam-btn-text');
      const camIcon = document.getElementById('cam-icon');
      const camContainer = document.getElementById('webcam-container');
      const statusBadge = document.getElementById('cam-status');

      if (!camActive) {
        try {
          await initMediaPipe();
          camContainer.classList.remove('hidden');
          statusBadge.classList.remove('hidden');
          btnText.innerText = 'Desactivar Cámara';
          camIcon.className = 'fa-solid fa-video-slash text-red-400';
          camActive = true;
        } catch(err) {
          alert('Error al acceder a la cámara. Asegúrate de dar permisos de cámara en el navegador o usar un servidor HTTPS/CodePen.');
          console.error(err);
        }
      } else {
        if(camera) camera.stop();
        camContainer.classList.add('hidden');
        statusBadge.classList.add('hidden');
        virtualPointer.classList.add('hidden');
        btnText.innerText = 'Activar Control Gestual';
        camIcon.className = 'fa-solid fa-camera text-white';
        camActive = false;
      }
    }

    function initMediaPipe() {
      return new Promise((resolve, reject) => {
        const videoElement = document.getElementById('webcam');
        const canvasElement = document.getElementById('webcam-canvas');
        const canvasCtx = canvasElement.getContext('2d');

        if(typeof Hands === 'undefined') {
          reject('Librería MediaPipe no cargada.');
          return;
        }

        const hands = new Hands({
          locateFile: (file) => `https://cdn.jsdelivr.net/npm/@mediapipe/hands/${file}`
        });

        hands.setOptions({
          maxNumHands: 1,
          modelComplexity: 1,
          minDetectionConfidence: 0.6,
          minTrackingConfidence: 0.6
        });

        hands.onResults((results) => {
          canvasCtx.save();
          canvasCtx.clearRect(0, 0, canvasElement.width, canvasElement.height);

          if (results.multiHandLandmarks && results.multiHandLandmarks.length > 0) {
            const landmarks = results.multiHandLandmarks[0];
            
            if(window.drawConnectors && window.drawLandmarks) {
              drawConnectors(canvasCtx, landmarks, HAND_CONNECTIONS, {color: '#38bdf8', lineWidth: 2});
              drawLandmarks(canvasCtx, landmarks, {color: '#f59e0b', lineWidth: 1, radius: 3});
            }

            const indexTip = landmarks[8];
            const thumbTip = landmarks[4];

            const screenX = (1 - indexTip.x) * window.innerWidth;
            const screenY = indexTip.y * window.innerHeight;

            virtualPointer.classList.remove('hidden');
            virtualPointer.style.left = `${screenX}px`;
            virtualPointer.style.top = `${screenY}px`;

            const distance = Math.hypot(indexTip.x - thumbTip.x, indexTip.y - thumbTip.y);
            const gestText = document.getElementById('gest-status-text');

            if (distance < 0.08) {
              isPinching = true;
              virtualPointer.classList.add('scale-125', 'bg-emerald-400/50', 'border-emerald-400');
              gestText.innerText = 'Pellizco: Ajustando Ángulo';
              
              forceAngle = Math.max(0, Math.min(360, Math.round((1 - indexTip.y) * 360)));
              document.getElementById('slider-angle').value = forceAngle;
              updateParams();
            } else {
              isPinching = false;
              virtualPointer.classList.remove('scale-125', 'bg-emerald-400/50', 'border-emerald-400');
              gestText.innerText = 'Mano Detectada';
            }
          } else {
            virtualPointer.classList.add('hidden');
            document.getElementById('gest-status-text').innerText = 'Buscando mano...';
          }
          canvasCtx.restore();
        });

        camera = new Camera(videoElement, {
          onFrame: async () => {
            await hands.send({image: videoElement});
          },
          width: 320,
          height: 240
        });

        camera.start().then(resolve).catch(reject);
      });
    }

    function checkAnswer(option) {
      const feedback = document.getElementById('quiz-feedback');
      feedback.classList.remove('hidden', 'text-emerald-400', 'text-red-400');
      
      if(option === 2) {
        feedback.innerText = '¡Correcto! Un pasador liso evita la traslación horizontal y vertical, introduciendo 2 reacciones (Rx, Ry).';
        feedback.classList.add('text-emerald-400');
      } else {
        feedback.innerText = 'Incorrecto. Los pasadores impiden traslaciones (2D) pero permiten rotación libre.';
        feedback.classList.add('text-red-400');
      }
    }

    window.onload = () => {
      setTimeout(() => {
        resizeCanvas();
        updateParams();
      }, 100);
    };
  </script>
</body>
</html>
